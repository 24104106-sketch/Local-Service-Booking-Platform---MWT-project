# FixIt Local Backend Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fixit_local
DB_USER=root
DB_PASSWORD=

# JWT Secret Key for Authentication
JWT_SECRET=fixit_local_jwt_secret_key_2026_dev_secure

# Client URL (Frontend URL for CORS & Socket.IO)
CLIENT_URL=http://localhost:5173

# Admin Initialization Configuration
ADMIN_EMAIL=admin@fixitlocal.com
ADMIN_PASSWORD=

# Google OAuth Configuration (Google Identity Services)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMTP Service Configuration (Nodemailer - Brevo Relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FixIt Local Support <no-reply@fixitlocal.com>"
RESET_TOKEN_EXPIRY_MINUTES=15

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Generic aliases
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Google Maps API Key
GOOGLE_MAPS_API_KEY=
